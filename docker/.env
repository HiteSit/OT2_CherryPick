# Environment variables for Docker Compose
# Copy this file to .env and customize as needed

# Docker Compose project name (affects volume/network naming)
COMPOSE_PROJECT_NAME=ot2cherrypick

# Port to expose the application on the host machine
# Default: 80 (http://localhost)
HOST_PORT=80

# GUI workspace directory name (inside container)
# Default: gui_state
OT2_GUI_WORKSPACE=gui_state

# Project directory used by backend + simulation logs (must match workspace path)
# Typically /app/<OT2_GUI_WORKSPACE>
OT2_PROJECT_DIR=/app/gui_state

# REQUIRED: Custom labware directory path (WSL/Linux format)
# This directory must exist on your system and contain Opentrons labware JSON files
# Windows path: C:\Users\ricca\AppData\Roaming\Opentrons\labware
# WSL/Linux path: /mnt/c/Users/ricca/AppData/Roaming/Opentrons/labware
# Update both variables below to match YOUR labware location:
LABWARE_PATH_HOST=/mnt/c/Users/ricca/AppData/Roaming/Opentrons/labware
LABWARE_PATH_MOUNT=/mnt/c/Users/ricca/AppData/Roaming/Opentrons/labware

# REQUIRED: Opentrons protocols parent directory (WSL/Linux format)
# Mount the entire protocols folder so you can switch between different protocol UUIDs
# without rebuilding containers. The specific protocol is configured in the GUI.
# Windows path: C:\Users\ricca\AppData\Roaming\Opentrons\protocols
# WSL/Linux path: /mnt/c/Users/ricca/AppData/Roaming/Opentrons/protocols
# Update both variables below to match YOUR Opentrons protocols folder:
PROTOCOLS_DIR_HOST=/mnt/c/Users/ricca/AppData/Roaming/Opentrons/protocols
PROTOCOLS_DIR_MOUNT=/mnt/c/Users/ricca/AppData/Roaming/Opentrons/protocols
