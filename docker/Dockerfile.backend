FROM python:3.12-slim-bookworm

# Copy the uv/uvx binaries from the official Astral image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OT2_GUI_WORKSPACE="gui_state"

WORKDIR /app

# Install system dependencies required for opentrons_simulate
# Note: opentrons_simulate is installed via PIPX in the project dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pipx \
    && rm -rf /var/lib/apt/lists/*

# Ensure pipx binaries are in PATH
ENV PATH="/root/.local/bin:$PATH"

# Copy the entire source code first (needed for editable install)
COPY . .

# Install Python dependencies using uv in editable mode
# Use --no-cache to reduce image size
RUN uv pip install --system --no-cache -e .

# Install opentrons_simulate globally via pipx
# This matches the development workflow where it's installed separately
RUN pipx install opentrons

# Create gui_state workspace directory
RUN mkdir -p gui_state/CSVs gui_state/logs

# Expose FastAPI port
EXPOSE 8000

# Run with --proxy-headers and --root-path for reverse proxy compatibility
CMD ["uvicorn", "src.gui.backend.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--proxy-headers", \
     "--root-path", "/api"]
