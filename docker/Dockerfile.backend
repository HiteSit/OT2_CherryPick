FROM python:3.12-slim-bookworm

# Build-time metadata (injected by CI or docker compose build)
ARG APP_VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="OT-2 CherryPick Backend" \
      org.opencontainers.image.description="FastAPI backend for OT-2 cherry-pick protocol generation and simulation" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/Hitesit/OT2_CherryPick" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"

# Copy the uv/uvx binaries from the official Astral image (pinned for reproducibility)
COPY --from=ghcr.io/astral-sh/uv:0.8.11 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OT2_GUI_WORKSPACE="gui_state"

WORKDIR /app

# Install system dependencies required for opentrons_simulate
# Note: opentrons_simulate is installed via PIPX in the project dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pipx \
    && rm -rf /var/lib/apt/lists/*

# Ensure pipx binaries are in PATH
ENV PATH="/root/.local/bin:$PATH"

# Copy dependency metadata first to leverage Docker layer caching
COPY pyproject.toml uv.lock ./

# Copy Python sources required for editable install (other assets copied later)
COPY src ./src

# Hatchling needs the project README referenced in pyproject
COPY README.md .

# Install Python dependencies using uv in editable mode (only reruns when deps or src/ change)
RUN uv pip install --system --no-cache -e .

# Copy the remaining source tree
COPY . .

RUN test -s /app/unlock.key || \
    (echo "Missing unlock.key. This checkout is locked." && exit 1)

# Install opentrons_simulate globally via pipx
# This matches the development workflow where it's installed separately
RUN pipx install opentrons

# Create gui_state workspace directory
RUN mkdir -p gui_state/CSVs gui_state/logs

# Expose FastAPI port
EXPOSE 8000

# Health check – mirrors the compose-level check for standalone usage
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/settings')" || exit 1

# Run with --proxy-headers and --root-path for reverse proxy compatibility
CMD ["uvicorn", "src.gui.backend.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--proxy-headers", \
     "--root-path", "/api"]
