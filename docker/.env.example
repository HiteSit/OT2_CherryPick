# Environment variables for Docker Compose
# Copy this file to .env and customize as needed:
#   cp .env.example .env

# Docker Compose project name (affects volume/network naming)
COMPOSE_PROJECT_NAME=ot2cherrypick

# Port to expose the application on the host machine
# Default: 80 (http://localhost)
HOST_PORT=80

# GUI workspace directory name (inside container)
# Default: gui_state
OT2_GUI_WORKSPACE=gui_state

# Project directory used by backend + simulation logs (must match workspace path)
# Typically /app/<OT2_GUI_WORKSPACE>
OT2_PROJECT_DIR=/app/gui_state

# REQUIRED: Opentrons App data directory (WSL/Linux format)
# This is the root Opentrons directory containing labware/ and protocols/ subdirectories.
# The system automatically derives:
#   - Custom labware path: {OPENTRONS_DIR}/labware
#   - Protocols directory: {OPENTRONS_DIR}/protocols
# Windows path: C:\Users\YOUR_USERNAME\AppData\Roaming\Opentrons
# WSL/Linux path: /mnt/c/Users/YOUR_USERNAME/AppData/Roaming/Opentrons
# Update both variables below to match YOUR Opentrons directory:
OPENTRONS_DIR_HOST=/mnt/c/Users/YOUR_USERNAME/AppData/Roaming/Opentrons
OPENTRONS_DIR_MOUNT=/mnt/c/Users/YOUR_USERNAME/AppData/Roaming/Opentrons
