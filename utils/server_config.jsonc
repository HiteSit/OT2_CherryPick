// OT2 CherryPick MCP Server - Standard Config
// Add to Claude Desktop: Settings > Developer > Edit Config > paste into "mcpServers"
// Or copy to ~/.claude/claude_desktop_config.json
{
  "mcpServers": {
    "ot2-cherrypick": {
      "command": "uv",
      "args": [
        "--directory", "${REPOSITORY_ROOT}",
        "run",
        "ot2-mcp-server"
      ],
      "env": {
        // Path to Opentrons custom labware JSON definitions (required for simulation)
        "LABWARE_PATH": "${LABWARE_PATH}",
        // Working project directory (server creates files here; omit to use temp dir)
        "OT2_PROJECT_DIR": "${OT2_PROJECT_DIR}"
      }
    }
  }
}
