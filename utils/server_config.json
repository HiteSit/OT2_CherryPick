{
  "mcpServers": {
    "ot2-cherrypick": {
      "command": "uv",
      "args": [
        "--directory", "${REPOSITORY_ROOT}",
        "run",
        "ot2-mcp-server"
      ],
      "env": {
        "LABWARE_PATH": "${LABWARE_PATH}",
        "OT2_PROJECT_DIR": "${OT2_PROJECT_DIR}"
      }
    }
  }
}
