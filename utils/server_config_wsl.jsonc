// OT2 CherryPick MCP Server - WSL Config (for Claude Desktop on Windows)
// Add to Claude Desktop: Settings > Developer > Edit Config > paste into "mcpServers"
// This launches the server inside WSL from a Windows host
{
  "mcpServers": {
    "ot2-cherrypick": {
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-c",
        // Single command string: set env vars + run server via uv
        // Edit the paths below to match your setup:
        //   LABWARE_PATH  = WSL path to Opentrons custom labware folder
        //   OT2_PROJECT_DIR = WSL path to your working project directory
        //   --directory   = WSL path to this repository root
        "LABWARE_PATH='/mnt/c/Users/ricca/AppData/Roaming/Opentrons/labware' OT2_PROJECT_DIR='/mnt/d/Amadteus_Main/OpenTron/OT2_CherryPick/utils/test_project' /home/hitesit/.local/bin/uv --directory /mnt/d/Amadteus_Main/OpenTron/OT2_CherryPick run ot2-mcp-server"
      ]
    }
  }
}
