{
  "suite_name": "liquid_presets",
  "description": "Tests liquid handling preset application. Verifies that each named preset correctly sets the expected TOML values in settings.toml.",
  "scenarios": [
    {
      "id": "05_001",
      "name": "Apply standard preset",
      "description": "Apply the standard liquid preset and verify all expected TOML values.",
      "tags": ["preset", "standard", "deterministic"],
      "difficulty": "easy",
      "expected_tools": ["apply_liquid_preset"],
      "max_steps": 10,
      "requires_simulation": false,
      "requires_workspace": true,
      "prompt": "Use the apply_liquid_preset tool to apply the 'standard' liquid handling preset.",
      "validations": {
        "toml_values": {
          "settings.toml": {
            "settings.liquid_handling.delays.post_aspirate": 0,
            "settings.liquid_handling.push_out.enabled": false,
            "settings.liquid_handling.pre_aspirate_contact.enabled": true,
            "settings.liquid_handling.post_aspirate_wick.enabled": true
          }
        },
        "response_contains_any": ["standard", "preset", "applied", "success"],
        "response_not_contains": ["traceback", "error:"]
      }
    },
    {
      "id": "05_002",
      "name": "Apply viscous preset",
      "description": "Apply the viscous liquid preset (DMSO-like) and verify delays and push-out.",
      "tags": ["preset", "viscous", "deterministic"],
      "difficulty": "easy",
      "expected_tools": ["apply_liquid_preset"],
      "max_steps": 10,
      "requires_simulation": false,
      "requires_workspace": true,
      "prompt": "Use the apply_liquid_preset tool to apply the 'viscous' preset for DMSO work.",
      "validations": {
        "toml_values": {
          "settings.toml": {
            "settings.liquid_handling.delays.post_aspirate": 2.0,
            "settings.liquid_handling.push_out.enabled": true,
            "settings.liquid_handling.push_out.volume_ul": 5,
            "settings.liquid_handling.pre_aspirate_contact.enabled": true,
            "settings.liquid_handling.post_aspirate_wick.enabled": true
          }
        },
        "response_contains_any": ["viscous", "preset", "applied", "success"],
        "response_not_contains": ["traceback", "error:"]
      }
    },
    {
      "id": "05_003",
      "name": "Apply slippery preset",
      "description": "Apply the slippery liquid preset and verify pre-aspirate contact volume.",
      "tags": ["preset", "slippery", "deterministic"],
      "difficulty": "easy",
      "expected_tools": ["apply_liquid_preset"],
      "max_steps": 10,
      "requires_simulation": false,
      "requires_workspace": true,
      "prompt": "Use the apply_liquid_preset tool to apply the 'slippery' liquid handling preset.",
      "validations": {
        "toml_values": {
          "settings.toml": {
            "settings.liquid_handling.pre_aspirate_contact.aspirate_volume": 5,
            "settings.liquid_handling.push_out.enabled": false
          }
        },
        "response_contains_any": ["slippery", "preset", "applied", "success"],
        "response_not_contains": ["traceback", "error:"]
      }
    },
    {
      "id": "05_004",
      "name": "Apply minimal preset",
      "description": "Apply the minimal preset which disables most liquid handling features.",
      "tags": ["preset", "minimal", "deterministic"],
      "difficulty": "easy",
      "expected_tools": ["apply_liquid_preset"],
      "max_steps": 10,
      "requires_simulation": false,
      "requires_workspace": true,
      "prompt": "Use the apply_liquid_preset tool to apply the 'minimal' liquid handling preset.",
      "validations": {
        "toml_values": {
          "settings.toml": {
            "settings.liquid_handling.pre_aspirate_contact.enabled": false,
            "settings.liquid_handling.push_out.enabled": false
          }
        },
        "response_contains_any": ["minimal", "preset", "applied", "success"],
        "response_not_contains": ["traceback", "error:"]
      }
    },
    {
      "id": "05_005",
      "name": "Apply preset via natural language (DMSO)",
      "description": "Fluidity test: user mentions DMSO without naming the preset. Agent should apply viscous preset.",
      "tags": ["preset", "fluidity", "implicit"],
      "difficulty": "medium",
      "expected_tools": ["apply_liquid_preset"],
      "max_steps": 12,
      "requires_simulation": false,
      "requires_workspace": true,
      "prompt": "I'm working with DMSO today. Configure the liquid handling appropriately.",
      "validations": {
        "toml_values": {
          "settings.toml": {
            "settings.liquid_handling.delays.post_aspirate": 2.0,
            "settings.liquid_handling.push_out.enabled": true
          }
        },
        "response_contains_any": ["viscous", "dmso", "preset", "configured", "applied"],
        "response_not_contains": ["traceback"]
      }
    },
    {
      "id": "05_006",
      "name": "Preset then override specific value",
      "description": "Apply viscous preset then override push_out volume. Tests preset + individual setting combo.",
      "tags": ["preset", "override", "compound"],
      "difficulty": "medium",
      "expected_tools": ["apply_liquid_preset", "update_settings"],
      "max_steps": 15,
      "requires_simulation": false,
      "requires_workspace": true,
      "prompt": "Apply the 'viscous' liquid preset, then change the push-out volume to 8 uL using update_settings with path 'settings.liquid_handling.push_out.volume_ul'.",
      "validations": {
        "toml_values": {
          "settings.toml": {
            "settings.liquid_handling.delays.post_aspirate": 2.0,
            "settings.liquid_handling.push_out.enabled": true,
            "settings.liquid_handling.push_out.volume_ul": 8
          }
        },
        "response_not_contains": ["traceback", "error:"]
      }
    }
  ]
}
